# ───────── Variables de PRODUCTION (à renseigner sur le VPS Hostinger) ─────────
# Copier en .env (lu par docker-compose) et remplir les valeurs réelles.

# --- Base de données (conteneur « db » de docker-compose) ---
POSTGRES_USER=nkulu
POSTGRES_PASSWORD=  # mot de passe FORT
POSTGRES_DB=nkulu
# (DATABASE_URL est construit automatiquement par docker-compose à partir de ces variables)

# --- Site ---
NEXT_PUBLIC_SITE_URL=https://votre-domaine.fr
SESSION_SECRET=  # openssl rand -hex 32
ADMIN_EMAILS=contact@votre-domaine.fr
DEFAULT_RESTAURANT_SLUG=nkulu-paris-11

# --- Paiement Stripe (optionnel mais recommandé) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_COUNTRY=FR

# --- Emails Resend (optionnel) ---
RESEND_API_KEY=
EMAIL_FROM=N'KULU <commandes@votre-domaine.fr>

# --- SMS / WhatsApp Twilio (optionnel) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=

# --- Commandes par WhatsApp / Telegram ---
NEXT_PUBLIC_WHATSAPP_ORDER_NUMBER=
NEXT_PUBLIC_TELEGRAM_ORDER_USERNAME=
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_TIKTOK_URL=
NEXT_PUBLIC_TELEGRAM_URL=
WHATSAPP_ORDER_TO=
TELEGRAM_BOT_TOKEN=
TELEGRAM_ORDER_CHAT_ID=

# --- Relance auto (cron) ---
CRON_SECRET=  # openssl rand -hex 16

# --- Rate-limiting distribué (Upstash Redis) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
